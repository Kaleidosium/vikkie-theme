{
  "name": "vikkie-theme",
  "displayName": "Vikkie!!! Theme",
  "description": "A purple VSCode theme based on luavixen's fursona Vikkie!!!",
  "icon": "images/vikkie-icon.png",
  "publisher": "atomicnumberphi",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kaleidosium/vikkie-theme.git"
  },
  "version": "2.0.1",
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "build": "pnpm dlx @vscode/vsce package --no-dependencies",
    "audit": "node scripts/audit.mjs",
    "test": "node --test scripts/tooling.test.mjs",
    "vscode:prepublish": "pnpm run audit"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "purple",
    "color-theme",
    "theme"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Vikkie!!! Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/vikkie-color-theme-dark.json"
      },
      {
        "label": "Vikkie!!! Light",
        "uiTheme": "vs",
        "path": "./themes/vikkie-color-theme-light.json"
      }
    ]
  },
  "devDependencies": {
    "culori": "^4.0.2"
  }
}
